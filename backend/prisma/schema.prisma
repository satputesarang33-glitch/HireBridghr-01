datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  RECRUITER
  HIRING_MANAGER
  INTERVIEWER
  VIEWER
  SUPER_ADMIN
  CANDIDATE
}

enum JobStatus {
  DRAFT
  PENDING_ADMIN_PUBLICATION
  PROCESSING
  PUBLISHED
  FAILED
  REJECTED
  CLOSED
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
}

enum WorkplaceType {
  REMOTE
  HYBRID
  ON_SITE
}

enum ApplicationStage {
  APPLIED
  SCREENING
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum InterviewType {
  PHONE
  VIDEO
  TECHNICAL
  HR
  ONSITE
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum DistributionPlatform {
  MANUAL
  LINKEDIN
  INDEED
  GOOGLE_JOBS
}

enum DistributionStatus {
  PENDING
  READY
  PROCESSING
  PUBLISHED
  FAILED
}

// -------------------------------------------------------------
// 1. User & Authentication Models
// -------------------------------------------------------------

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String?
  name               String
  firstName          String?
  lastName           String?
  phone              String?
  avatar             String?
  jobTitle           String?
  location           String?
  headline           String?
  bio                String?
  role               Role      @default(RECRUITER)
  status             String    @default("ACTIVE")
  isEmailVerified    Boolean   @default(false)
  skills             String[]  @default([])
  experienceYears    Int       @default(0)
  linkedinUrl        String?
  githubUrl          String?
  portfolioUrl       String?
  resumeUrl          String?
  resumeFileName     String?
  resumeFileSize     String?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  memberships        OrganizationMembership[]
  refreshTokens      RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  createdJobs        Job[]
  candidateProfile   Candidate?
  interviews         Interview[] @relation("InterviewerRelation")
  notifications      Notification[]
  auditLogs          AuditLog[]
  savedJobs          SavedJob[]

  @@index([email])
  @@index([status])
  @@map("users")
}

model Organization {
  id               String    @id @default(uuid())
  name             String
  slug             String    @unique
  type             String    @default("COMPANY") // COMPANY, STAFFING, AGENCY
  industry         String?
  size             String?
  website          String?
  country          String?
  city             String?
  timeZone         String    @default("UTC")
  status           String    @default("ACTIVE")

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  memberships      OrganizationMembership[]
  invitations      Invitation[]
  jobs             Job[]
  candidates       Candidate[]
  applications     Application[]
  interviews       Interview[]
  notifications    Notification[]
  auditLogs        AuditLog[]

  @@index([slug])
  @@index([status])
  @@map("organizations")
}

model OrganizationMembership {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           Role         @default(RECRUITER)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_memberships")
}

model Invitation {
  id             String       @id @default(uuid())
  organizationId String
  email          String
  role           Role         @default(RECRUITER)
  tokenHash      String       @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?

  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([tokenHash])
  @@map("invitations")
}

model RefreshToken {
  id                  String    @id @default(uuid())
  userId              String
  tokenHash           String    @unique
  revoked             Boolean   @default(false)
  replacedByTokenHash String?
  userAgent           String?
  ipAddress           String?
  expiresAt           DateTime

  createdAt           DateTime  @default(now())

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime

  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime

  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("email_verification_tokens")
}

// -------------------------------------------------------------
// 2. Job & Distribution Models
// -------------------------------------------------------------

model Job {
  id                     String            @id @default(uuid())
  organizationId         String
  slug                   String
  title                  String
  client                 String?
  department             String?
  location               String?
  workplaceType          WorkplaceType     @default(REMOTE)
  employmentType         EmploymentType    @default(FULL_TIME)
  experienceMin          Int?              @default(0)
  experienceMax          Int?
  experienceLevel        String?
  salaryMin              Float?
  salaryMax              Float?
  currency               String            @default("USD")
  skills                 String[]          @default([])
  description            String
  responsibilities       String?
  requirements           String?
  status                 JobStatus         @default(DRAFT)
  recruiterId            String?
  recruiterName          String?
  contactPerson          String?
  candidateEmail         String?
  isPublic               Boolean           @default(true)
  isResumeRequired       Boolean           @default(true)
  deadline               DateTime?
  applicationsCount      Int               @default(0)
  publishedAt            DateTime?
  closedAt               DateTime?

  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  organization           Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recruiter              User?             @relation(fields: [recruiterId], references: [id], onDelete: SetNull)
  distributions          JobDistribution[]
  applications           Application[]
  savedByCandidates      SavedJob[]

  @@index([organizationId])
  @@index([status])
  @@index([department])
  @@index([location])
  @@map("jobs")
}

model JobDistribution {
  id            String               @id @default(uuid())
  jobId         String
  platform      DistributionPlatform @default(MANUAL)
  status        DistributionStatus   @default(PENDING)
  requestedAt   DateTime?            @default(now())
  publishedAt   DateTime?
  externalJobId String?
  error         String?
  internalNotes String?

  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  job           Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([status])
  @@map("job_distributions")
}

model SavedJob {
  id        String   @id @default(uuid())
  userId    String
  jobId     String

  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@map("saved_jobs")
}

// -------------------------------------------------------------
// 3. Candidate & Document Models
// -------------------------------------------------------------

model Candidate {
  id                   String              @id @default(uuid())
  organizationId       String
  userId               String?             @unique
  name                 String
  firstName            String?
  lastName             String?
  email                String
  phone                String?
  location             String?
  currentTitle         String?
  company              String?
  skills               String[]            @default([])
  experienceYears      Int                 @default(0)
  rating               Float               @default(5.0)
  status               String              @default("ACTIVE")
  source               String              @default("Direct Application")
  tags                 String[]            @default([])
  portfolioUrl         String?
  linkedinUrl          String?
  githubUrl            String?
  resumeUrl            String?
  resumeFileName       String?
  resumeFileSize       String?
  resumeStoragePath    String?
  assignedRecruiterId  String?
  assignedRecruiterName String?

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                 User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  notes                CandidateNote[]
  documents            CandidateDocument[]
  applications         Application[]
  interviews           Interview[]

  @@index([organizationId])
  @@index([email])
  @@index([status])
  @@map("candidates")
}

model CandidateNote {
  id          String    @id @default(uuid())
  candidateId String
  authorId    String?
  authorName  String
  content     String
  rating      Float?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_notes")
}

model CandidateDocument {
  id           String    @id @default(uuid())
  candidateId  String
  fileName     String
  fileSize     Int?
  mimeType     String?
  storagePath  String
  documentType String    @default("RESUME")

  createdAt    DateTime  @default(now())

  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_documents")
}

// -------------------------------------------------------------
// 4. Application Models
// -------------------------------------------------------------

model Application {
  id             String                @id @default(uuid())
  organizationId String
  jobId          String
  candidateId    String
  candidateName  String
  candidateEmail String
  candidatePhone String?
  jobTitle       String?
  company        String?
  resumeUrl      String?
  resumeFileName String?
  coverLetter    String?
  portfolioUrl   String?
  linkedinUrl    String?
  githubUrl      String?
  stage          ApplicationStage      @default(APPLIED)
  status         String                @default("APPLIED")
  source         String                @default("Website")
  appliedDate    DateTime              @default(now())

  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job            Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate      Candidate             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  activities     ApplicationActivity[]
  interviews     Interview[]

  @@unique([jobId, candidateId])
  @@index([organizationId])
  @@index([jobId])
  @@index([candidateId])
  @@index([stage])
  @@map("applications")
}

model ApplicationActivity {
  id            String      @id @default(uuid())
  applicationId String
  actorId       String?
  actorName     String
  type          String      // STAGE_CHANGE, NOTE_ADDED, INTERVIEW_SCHEDULED
  title         String
  notes         String?
  previousStage String?
  newStage      String?

  createdAt     DateTime    @default(now())

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_activities")
}

// -------------------------------------------------------------
// 5. Interview Models
// -------------------------------------------------------------

model Interview {
  id              String             @id @default(uuid())
  organizationId  String
  applicationId   String
  candidateId     String
  candidateName   String?
  jobId           String
  jobTitle        String?
  interviewerId   String?
  interviewerName String?
  interviewType   InterviewType      @default(VIDEO)
  scheduledDate   DateTime
  startTime       String?
  duration        Int                @default(45) // duration in minutes
  meetingUrl      String?
  location        String?
  status          InterviewStatus    @default(SCHEDULED)
  notes           String?

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  application     Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidate       Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewer     User?              @relation("InterviewerRelation", fields: [interviewerId], references: [id], onDelete: SetNull)
  feedback        InterviewFeedback?

  @@index([organizationId])
  @@index([applicationId])
  @@index([candidateId])
  @@index([interviewerId])
  @@index([status])
  @@map("interviews")
}

model InterviewFeedback {
  id             String    @id @default(uuid())
  interviewId    String    @unique
  authorId       String?
  authorName     String
  rating         Float
  recommendation String    // STRONG_HIRE, HIRE, NO_HIRE
  pros           String?
  cons           String?
  notes          String?
  submittedAt    DateTime  @default(now())

  interview      Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@map("interview_feedbacks")
}

// -------------------------------------------------------------
// 6. Notification & Audit Log Models
// -------------------------------------------------------------

model Notification {
  id             String        @id @default(uuid())
  organizationId String?
  userId         String
  title          String
  message        String
  type           String        // APPLIED, INTERVIEW, STATUS_CHANGE, SYSTEM
  link           String?
  jobId          String?
  isRead         Boolean       @default(false)

  createdAt      DateTime      @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([isRead])
  @@map("notifications")
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?
  actorId        String?
  actorEmail     String?
  actorRole      String?
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  requestId      String?

  createdAt      DateTime      @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([actorId])
  @@index([action])
  @@index([resourceType])
  @@map("audit_logs")
}
